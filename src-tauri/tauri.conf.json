{
  "$schema": "https://raw.githubusercontent.com/nicobrinkkemper/tauri-v2-schema/main/tauri.conf.json",
  "productName": "Kimbo",
  "version": "0.16.1",
  "identifier": "com.kimbo.terminal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:frontend && cargo build --release -p kimbo-claude-statusline && cargo build --release -p kimbo-claude-notify"
  },
  "app": {
    "windows": [
      {
        "title": "Kimbo",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "backgroundThrottling": "disabled",
        "shadow": true,
        "acceptFirstMouse": true,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Luca Tescari",
    "copyright": "Copyright © 2026 Luca Tescari",
    "category": "DeveloperTool",
    "shortDescription": "A fast, themeable terminal emulator",
    "longDescription": "Kimbo is a fast, themeable terminal emulator built with Rust and Tauri, with multi-pane layouts, tabbed windows, and a command palette for developer workflows.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/shell/kimbo-init.zsh",
      "resources/shell/kimbo-init.bash",
      "resources/shell/kimbo-init.fish",
      "icons/128x128.png"
    ],
    "externalBin": [
      "binaries/kimbo-claude-statusline",
      "binaries/kimbo-claude-notify"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/lucatescari/kimbo-terminal/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMjJBQTJEMzQ5QzJCNjAKUldSZ0s1dzBMYW9pSDJVUFpxM1U2NU9SMkNqc3BON3F5ZzYrQ1k2Vk5jblpmT2tKdWtGSDF3d3oK"
    },
    "opener": {
      "requireLiteralLeadingDot": false
    }
  }
}
