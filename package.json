{
  "name": "kimbo-terminal",
  "version": "1.2.1",
  "description": "A fast, themeable terminal emulator built with Rust and Tauri",
  "author": "Luca Tescari",
  "license": "MIT",
  "homepage": "https://kimbo.tescari.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucatescari/kimbo-terminal.git"
  },
  "type": "module",
  "scripts": {
    "start": "cargo tauri dev",
    "build": "cargo tauri build",
    "dev": "vite",
    "build:frontend": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "test:rust": "cargo test -p kimbo-terminal -p kimbo-config",
    "test:all": "vitest run && vitest run -c vitest.browser.config.ts && cargo test -p kimbo-terminal -p kimbo-config",
    "test:release": "vitest run --no-file-parallelism && vitest run -c vitest.browser.config.ts --no-file-parallelism && cargo test -p kimbo-terminal -p kimbo-config",
    "release": "./scripts/release.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@sentry/browser": "^10.71.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "tauri-plugin-sentry-api": "^0.5.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.4"
  }
}
