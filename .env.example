# Copy to `.env` (gitignored) and fill in. release.sh sources it automatically.
# These are release-signing secrets — never commit the real .env.

# Password that unlocks the Tauri updater signing key
# (~/.tauri/kimbo_updater.key), set when the key was generated.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Optional overrides (release.sh has sensible defaults for these):
# TAURI_SIGNING_PRIVATE_KEY=/Users/you/.tauri/kimbo_updater.key
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=
